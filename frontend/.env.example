# Ponder GraphQL endpoint (history, charts, scoreboard). Live balances come straight from the chain.
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069/graphql
# Free ID from https://cloud.reown.com; enables WalletConnect (QR and mobile wallets).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Use a private RPC in production: the public one rate-limits.
NEXT_PUBLIC_RPC_URL=https://sepolia.unichain.org
